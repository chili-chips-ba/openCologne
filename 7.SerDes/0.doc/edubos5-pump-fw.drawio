ints"><mxPoint x="1440" y="285"/><mxPoint x="1440" y="860"/></Array></mxGeometry></mxCell><mxCell id="c59" value="&lt;b&gt;no&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;fontColor=#c62828;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1220" y="263" width="40" height="18" as="geometry"/></mxCell><mxCell id="c60" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1054" y="854" width="12" height="12" as="geometry"/></mxCell><mxCell id="c61" style="endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="860" as="sourcePoint"/><mxPoint x="330" y="233" as="targetPoint"/><Array as="points"><mxPoint x="1060" y="920"/><mxPoint x="40" y="920"/><mxPoint x="40" y="215"/><mxPoint x="330" y="215"/></Array></mxGeometry></mxCell><mxCell id="c62" value="again: back to send" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="900" width="300" height="20" as="geometry"/></mxCell><mxCell id="c63" value="" style="shape=image;image=data:image/png,;imageAspect=1;aspect=fixed;rotation=20;" vertex="1" parent="1"><mxGeometry x="1440" y="54" width="34" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
