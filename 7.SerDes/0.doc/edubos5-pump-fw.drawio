ica;" vertex="1" parent="1"><mxGeometry x="180.0" y="365" width="300" height="110" as="geometry"/></mxCell><mxCell id="c22" style="endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="475" as="sourcePoint"/><mxPoint x="330" y="505" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;yes&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="338" y="475" width="40" height="18" as="geometry"/></mxCell><mxCell id="c24" value="header word: magic, seq, n&lt;br&gt;&lt;span style='font-family:Courier New;color:#00838f;font-weight:bold'&gt;TX_DATA = {0xA5, seq, 8'h00, n}&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160.0" y="505" width="340" height="64" as="geometry"/></mxCell><mxCell id="c25" style="endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="569" as="sourcePoint"/><mxPoint x="330" y="595" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="the n payload words&lt;br&gt;&lt;span style='font-family:Courier New;color:#00838f;font-weight:bold'&gt;TX_DATA = word[i], i = 0 .. n-1&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160.0" y="595" width="340" height="64" as="geometry"/></mxCell><mxCell id="c27" style="endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;html=1;" edge=