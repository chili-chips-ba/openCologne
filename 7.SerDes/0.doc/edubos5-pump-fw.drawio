;go and receive&lt;/b&gt;, try again next time round; spinning here can deadlock two echoing sides" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="760" width="240" height="80" as="geometry"/></mxCell><mxCell id="c35" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="324" y="854" width="12" height="12" as="geometry"/></mxCell><mxCell id="c36" style="endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="860" as="sourcePoint"/><mxPoint x="1060" y="233" as="targetPoint"/><Array as="points"><mxPoint x="330" y="880"/><mxPoint x="680" y="880"/><mxPoint x="680" y="215"/><mxPoint x="1060" y="215"/></Array></mxGeometry></mxCell><mxCell id="c37" value="then receive" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="862" width="160" height="20" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=0;fillColor=#e3eef9;strokeColor=#9e9e9e;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="190" width="780" height="700" as="geometry"/></mxCell><mxCell id="c39" value="receive: the next message" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#424242;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="708" y="194" width="764" height="24" as="geometry"/></mxCell><mxCell id="c40" value="a header waiting?&lt;br&gt;&lt;span style='font-family:Courier New;color:#00838f'&gt;&lt;b&gt;STATUS.rx_level &amp;gt;= 1&lt;/b&gt;&lt;/span&gt;" style="rhombus;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" pa