<mxfile><diagram name="Page-1"><mxGraphModel dx="1400" dy="470" grid="0" page="1" pageWidth="1400" pageHeight="470" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="A Serial Wishbone packet" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1b2433;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1400" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:22px'&gt;idle&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;K28.1 fill&lt;/span&gt;" style="rounded=0;fillColor=#9e9e9e;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="130" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:22px'&gt;preamble&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;4 bytes&lt;br&gt;0x5AA55AA5&lt;/span&gt;" style="rounded=0;fillColor=#1565c0;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190" y="90" width="190" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:22px'&gt;port&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;1 byte&lt;/span&gt;" style="rounded=0;fillColor=#00838f;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="110" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:22px'&gt;length&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;2 bytes&lt;/span&gt;" style="rounded=0;fillColor=#00838f;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="90" width="150" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:22px'&gt;0&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;1 byte&lt;/span&gt;" style="rounded=0;fillColor=#90a4ae;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="70" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:22px'&gt;payload&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;length bytes&lt;br&gt;(4 per word)&lt;/span&gt;" style="rounded=0;fillColor=#2e7d32;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="710" y="90" width="330" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style='font-size:22px'&gt;CRC32&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;4 bytes&lt;br&gt;(with CRC)&lt;/span&gt;" style="rounded=0;fillColor=#c62828;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="170" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:22px'&gt;idle&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:15px'&gt;K28.1 fill&lt;/span&gt;" style="rounded=0;fillColor=#9e9e9e;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1210" y="90" width="130" height="110" as="geometry"/></mxCell><mxCell id="c12" value="header: word 0 and word 1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#37474f;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="190" y="212" width="520" height="30" as="geometry"/></mxCell><mxCell id="c13" style="endArrow=block;endFill=1;endSize=4;startArrow=block;startFill=1;startSize=4;strokeColor=#37474f;strokeWidth=2;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="194" y="206" as="sourcePoint"/><mxPoint