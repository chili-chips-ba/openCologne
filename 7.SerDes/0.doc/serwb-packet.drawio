Space=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="120" y="162" width="640" height="46" as="geometry"/></mxCell><mxCell id="c19" value="" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10" y="208" width="105" height="46" as="geometry"/></mxCell><mxCell id="c20" value="...  length / 4 words" style="rounded=0;fillColor=#e5f3e5;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="120" y="208" width="640" height="46" as="geometry"/></mxCell><mxCell id="c21" value="last" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10" y="254" width="105" height="46" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;CRC32&lt;/b&gt; over header and payload (with_crc)" style="rounded=0;fillColor=#fde7e7;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;dashed=1;" vertex="1" parent="1"><mxGeometry x="120" y="254" width="640" height="46" as="geometry"/></mxCell><mxCell id="c23" value="Receiver: hunts for the preamble between packets only; inside a packet it counts length. Unknown port, zero length, bad CRC or a 1 ms gap: packet dropped." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="308" width="640" height="60" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;port 0: Etherbone (remote memory access)&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="830" y="70" width="640" height="40" as="geometry"/></mxCell><mxCell id="c25" value="Etherbone header: magic 0x4E6F, version 1, flags" style="rounded=0;fillColor=#e5f3e5;strokeColor=#000000;strokeWidth=1;fontSize=13;fontColor=#000000;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="640" height="36" as="geometry"/></mxCell><mxCell id="c26" value="Etherbone header (rest, zero)" style="rounded=0;fillColor=#e5f3e5;strokeColor=#000000;strokeWidth=1;fontSize=13;fontColor=#000000;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="830" y="146" width="640" height="36" as="geometry"/></mxCell><mxCell id="c27" value="record header: flags, byte_enable, wcount, rcount" style="rounded=0;fillColor=#e5f3e5;strokeColor=#000000;strokeWidth=1;fontSize=13;fontColor=#000000;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="830" y="182" width="640" height="36" as="geometry"/></mxCell><mxCell id="c28" value="base address / return address" style="rounded=0;fillColor=#e5f3e5;strokeColor=#000000;strokeWidth=1;fontSize=13;fontColor=#000000;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="830" y="218" width="640" height="36" as="geometry"/></mxCell><mxCell id="c29" value="write: wcount data words; read: rcount addresses" style="rounded=0;fillColor=#e5f3e5;strokeColor=#000000;strokeWidth=1;fontSize=13;fontColor=#000000;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="830" y="254" width="640" height="36" as="geometry"/></mxCell><mxCell id="c30" value="one 32-bit write = 7 words (8 with CRC); a read is a round trip" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="294" width="640" height="24" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;port 2: FIFO pump (eduBOS5 messages)&lt;/b&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="830" y="336" width="640" height="40" as="geometry"/></mxCell><mxCell id="c32" value="up to 16 data words, in FIFO order" style="rounded=0;fillColor=#e5f3e5;strokeColor=#000000;strokeWidth=1;fontSize=13;fontColor=#000000;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="830" y="376" width="640" height="36" as="geometry"/></mxCell><mxCell id="c33" value="16 words + preamble + port/length + CRC = 19 words: 84% payload" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="418" width="640" height="24" as="geometry"/></mxCell><mxCell id="c34" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="762" y="210" as="sourcePoint"/><mxPoint x="826" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="762" y="210" as="sourcePoint"/><mxPoint x="826" y="394" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="payload" style="text;html=1;align=left;fontSize=12;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="766" y="214" width="60" height="30" as="geometry"/></mxCell><mxCell id="c37" value="On the line: 8b/10b symbols, 8 per PHY clock (two SerWB words: bytes 0-3, 4-7)" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1460" height="28" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;K28.1&lt;/b&gt;&lt;br&gt;fill" style="rounded=0;fillColor=#efefef;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="158" height="56" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;K28.5&lt;/b&gt;&lt;br&gt;comma" style="rounded=0;fillColor=#efefef;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="202" y="510" width="158" height="56" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;5AA55AA5&lt;/b&gt;&lt;br&gt;preamble" style="rounded=0;fillColor=#e3eef9;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="364" y="510" width="158" height="56" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;port/len&lt;/b&gt;" style="rounded=0;fillColor=#e3eef9;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="526" y="510" width="158" height="56" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;payload&lt;/b&gt;" style="rounded=0;fillColor=#e5f3e5;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="688" y="510" width="158" height="56" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;...&lt;/b&gt;" style="rounded=0;fillColor=#e5f3e5;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="850" y="510" width="158" height="56" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;CRC32&lt;/b&gt;" style="rounded=0;fillColor=#fde7e7;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1012" y="510" width="158" height="56" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;K28.1&lt;/b&gt;&lt;br&gt;fill" style="rounded=0;fillColor=#efefef;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1174" y="510" width="158" height="56" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;K28.3&lt;/b&gt;&lt;br&gt;XOFF" style="rounded=0;fillColor=#fff3e0;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1336" y="510" width="158" height="56" as="geometry"/></mxCell><mxCell id="c47" value="one box = one 32-bit SerWB word = 4 symbols; time runs left to right" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="574" width="1420" height="24" as="geometry"/></mxCell><mxCell id="c48" value="K28.5" style="rounded=0;fillColor=#efefef;strokeColor=#000000;strokeWidth=1;fontSize=13;fontColor=#000000;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="200" height="32" as="geometry"/></mxCell><mxCell id="c49" value="comma: alignment at link start-up" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;align=left;spacingLeft=8;fontSize=13;fontColor=#000000;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="610" width="700" height="32" as="geometry"/></mxCell><mxCell id="c50" value="K28.1" style="rounded=0;fillColor=#efefef;strokeColor=#000000;strokeWidth=1;fontSize=13;fontColor=#000000;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="642" width="200" height="32" as="geometry"/></mxCell><mxCell id="c51" value="fill between packets (with flow control; else zero words)" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;align=left;spacingLeft=8;fontSize=13;fontColor=#000000;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="642" width="700" height="32" as="geometry"/></mxCell><mxCell id="c52" value="K28.3 / K28.4" style="rounded=0;fillColor=#efefef;strokeColor=#000000;strokeWidth=1;fontSize=13;fontColor=#000000;html=1;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="40" y="674" width="200" height="32" as="geometry"/></mxCell><mxCell id="c53" value="XOFF / XON: pause / resume the far transmitter" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;align=left;spacingLeft=8;fontSize=13;fontColor=#000000;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="674" width="700" height="32" as="geometry"/></mxCell><mxCell id="c54" value="Control symbols sit in byte 0 of a word, K flag set; data bytes are D characters. 8b/10b keeps data from ever looking like a K symbol, but data can look like the preamble: hence length counting and CRC." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="970" y="610" width="500" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
