<mxfile><diagram name="Page-1"><mxGraphModel dx="1700" dy="800" grid="0" page="1" pageWidth="1700" pageHeight="800" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="FIFO pump, end to end: buffers, thresholds and the flow-control loop, all on one clock (clk_core)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1660" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;fillColor=#fff3e0;strokeColor=#9e9e9e;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="600" height="560" as="geometry"/></mxCell><mxCell id="c5" value="side A (sender)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#424242;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="28" y="54" width="584" height="22" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;fillColor=#efefef;strokeColor=#9e9e9e;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="360" height="560" as="geometry"/></mxCell><mxCell id="c7" value="the link, LINE_LAT clocks each way" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#424242;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="648" y="54" width="344" height="22" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;fillColor=#e3eef9;strokeColor=#9e9e9e;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1020" y="50" width="660" height="560" as="geometry"/></mxCell><mxCell id="c9" value="side B (receiver)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#424242;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1028" y="54" width="644" height="22" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;CPU A&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Hel