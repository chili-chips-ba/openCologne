ometry"/></mxCell><mxCell id="c37" value="" style="rounded=0;fillColor=#c62828;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1320" y="156.5" width="110" height="3" as="geometry"/></mxCell><mxCell id="c38" value="832: XOFF level" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#c62828;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1434" y="146.5" width="200" height="22" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=0;fillColor=#2e7d32;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1320" y="269.0" width="110" height="3" as="geometry"/></mxCell><mxCell id="c40" value="512: XON level" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2e7d32;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1434" y="259.0" width="200" height="22" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;RX FIFO&lt;/b&gt;" style="text;html=1;align=center;fontSize=15;fontColor=#000000;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1300" y="90" width="150" height="24" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;CPU B&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Helvetica;font-size:13px'&gt;clk_core&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1560" y="330" width="110" height="70" as="geometry"/></mxCell><mxCell id="c43" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#1565c0;strokeWidth=3;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="185" as="sourcePoint"/><mxPoint x="196" y="185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#1565c0;strokeWidth=3;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="185" as="sourcePoint"/><mxPoint x="366" y="185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#1565c0;strokeWidth=3;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="185" as="sourcePoint"/><mxPoint x="656" y="185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="packets, K28.1 fill between them" style="text;html=1;align=center;verticalAlign=top;fontSize=13;fontColor=#1565c0;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="320" height="30" as="geometry"/></mxCell><mxCell id="c47" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#1565c0;strokeWidth=3;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="185" as="sourcePoint"/><mxPoint x="1036" y="185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#1565c0;strokeWidth=3;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="185" as="sourcePoint"/><mxPoint x="1326" y="185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#1565c0;strokeWidth=3;edgeStyle=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1420" y="365" as="sourcePoint"/><mxPoint x="1556" y="365" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="pop" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1565c0;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="338" width="60" height="24" as="geometry"/></mxCell><mxCell id="c51" value="push" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#1565c0;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="152" y="150" width="60" height="30" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=0;fillColor=#c62828;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1312" y="120" width="3" height="37.5" as="geometry"/></mxCell><mxCell id="c53" value="margin 192 words:&lt;br&gt;the round trip" style="text;html=1;align=right;verticalAlign=top;fontSize=12;fontColor=#c62828;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="104" width="145" height="40" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;pause&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Helvetica;font-size:13px'&gt;set at &gt;= 832, cleared at &lt; 512&lt;br&gt;(hysteresis)&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#c62828;strokeWidth=1.5;fontSize=15;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1260" y="470" width="230" height="80" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;B line mux&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Helvetica;font-size:13px'&gt;XOFF K28.3 / XON K28.4,&lt;br&gt;one clock, even mid-packet&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="1040" y="470" width="200" height="80" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;line B -&gt; A&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Helvetica;font-size:13px'&gt;the same LINE_LAT&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="660" y="470" width="320" height="80" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;A RX: K28.3 seen&lt;/b&gt;&lt;br&gt;&lt;span style='font-family:Helvetica;font-size:13px'&gt;remote_paused holds&lt;br&gt;the packetizer&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=15;fontColor=#000000;html=1;whiteSpace=wrap;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="230" height="80" as="geometry"/></mxCell><mxCell id="c58" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#c62828;strokeWidth=2;edgeStyle=none;dashed=1;dashPattern=8 5;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1375" y="420" as="sourcePoint"/><mxPoint x="1375" y="466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#c62828;strokeWidth=2;edgeStyle=none;dashed=1;dashPattern=8 5;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1256" y="510" as="sourcePoint"/><mxPoint x="1244" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#c62828;strokeWidth=2;edgeStyle=none;dashed=1;dashPattern=8 5;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1036" y="510" as="sourcePoint"/><mxPoint x="984" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#c62828;strokeWidth=2;edgeStyle=none;dashed=1;dashPattern=8 5;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="656" y="510" as="sourcePoint"/><mxPoint x="604" y="510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" style="endArrow=block;endFill=1;endSize=7;startArrow=none;startFill=1;startSize=7;strokeColor=#c62828;strokeWidth=2;edgeStyle=none;dashed=1;dashPattern=8 5;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="466" as="sourcePoint"/><mxPoint x="485" y="234" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value="o_ready = 0" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#c62828;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="430.0" y="330.0" width="300" height="20" as="geometry"/></mxCell><mxCell id="c64" value="" style="shape=image;image=data:image/png,;imageAspect=1;aspect=fixed;rotation=20;" vertex="1" parent="1"><mxGeometry x="568" y="236" width="34" height="34" as="geometry"/></mxCell><mxCell id="c65" value="" style="shape=image;image=data:image/png,;imageAspect=1;aspect=fixed;rotation=20;" vertex="1" parent="1"><mxGeometry x="1238" y="236" width="34" height="34" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;Round trip, measured&lt;/b&gt; (tb_serwb_pump, LINE_LAT 31, one clock): XOFF reaches A in &lt;b&gt;34 clocks&lt;/b&gt; = 3 + LINE_LAT (pause flop, request flop, TX flop, line, K28.3 detect flop; no synchronizers); the last word A sent lands &lt;b&gt;65 clocks&lt;/b&gt; after XOFF = 3 + 2 x LINE_LAT, plus the packet in flight (B peaks 63 clocks after XOFF).&lt;br&gt;&lt;b&gt;Overshoot&lt;/b&gt; above the XOFF level &amp;lt;= 2 words x 65 clocks = &lt;b&gt;130 words&lt;/b&gt; at full line rate; measured &lt;b&gt;71&lt;/b&gt; (A's CPU pushes at most 1 word a clock). The margin of 192 words covers LINE_LAT up to &lt;b&gt;46 clocks&lt;/b&gt; each way.&lt;br&gt;&lt;b&gt;XON level&lt;/b&gt; 512: the reader must not run dry while XON travels and data comes back (65 clocks, about 65 words); 512 leaves 8x that, and the 320-word hysteresis keeps XOFF / XON from chattering.&lt;br&gt;&lt;b&gt;TX FIFO&lt;/b&gt; 1024: the CPU's burst buffer; it fills only while B holds A off, then tx_full pushes back on CPU A.&lt;br&gt;&lt;b&gt;Levels are exact:&lt;/b&gt; one clock, synchronous FIFOs, so each level is a flop from both pointers of the same clock." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="625" width="1660" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
