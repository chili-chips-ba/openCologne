// Waivers for our RTL in the unit tests, the same as in
// 3.build/run-lint-waivers.txt.
`verilator_config

// a package serves several designs: a constant one test does not use is not
// dead (as in 3.build/run-lint-waivers.txt)
lint_off -rule UNUSEDPARAM -file "*1.hw/iclink_*pkg.sv"
