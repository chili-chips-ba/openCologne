#
# Pins of the 7.SerDes/3.iclink-sv board top (1.hw/top.sv) on the Cologne
# Chip GateMate A1 EVB. Only the ports top.sv has: nextpnr rejects a pin
# for a port the design does not have.

Pin_in  "clk"   Loc = "IO_SB_A8" | SCHMITT_TRIGGER=true;  # CLK0, 10 MHz
Pin_in  "btn_n" Loc = "IO_SB_B7" | PULLUP=true;           # FPGA_BUT, low when pressed
Pin_out "led"   Loc = "IO_SB_B6";                         # FPGA_LED
